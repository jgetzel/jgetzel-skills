#!/bin/sh
# lua-lean: LuaJIT scripts to Lean, with proofs (DESIGN.md). Needs lake (elan) on the PATH, or nix to fetch it; parsecheck
# and difftest run the reference LuaJIT (DESIGN.md): $LUAJIT if set, else the repo flake's, else the PATH's.
#   lua-lean lift <file.lua> [<Namespace> [<Import>:<Const>]] [--only <f>,...]  the Lean module: each function's
#                                         body, shallow form and proof (D.fn_ok); --only: those and their nested ones
#   lua-lean prove <file.lua>...          lift each into a scratch directory and check its proofs
#   lua-lean dump (<Name> <file.lua>)...  each file's syntax tree as `def <Name>Src : Block`
#   lua-lean print <file.lua>             the parsed file printed back as Lua
#   lua-lean parsecheck <file.lua>...     the parser against LuaJIT: printed back, each compiles to the source's bytecode
#   lua-lean run [--lib <prefix>=<dir>]... <file.lua>...  each chunk's results under the Lean semantics
#   lua-lean cases <n> <seed> <file>      random chunks with the Lean semantics' results
#   lua-lean difftest [<n> [<seed>]]      that many fresh chunks (3000) under LuaJIT, JIT on and off: the same results
#   lua-lean luajit                       the path of the LuaJIT the others run
#   lua-lean check [-n <per>] [--lean] <file.lua>...  what is outside the subset, by line; <per> (20) random calls
#                                         of each top-level function under the semantics and (but --lean) LuaJIT
#   lua-lean corpus [-t <secs>] [<dir>]   fetch test/corpus.txt's scripts into <dir> and check them, under the
#                                         semantics only: what parses, what is in the subset, the commonest misses;
#                                         a file still checking after <secs> (120; 0: no limit) is reported timed out
here=$(cd "$(dirname "$0")" && pwd)
abs() { case $1 in /*) printf %s "$1" ;; *) printf %s "$PWD/$1" ;; esac; }
lake_do() { (cd "$here" && if command -v lake >/dev/null; then lake "$@"; else nix shell nixpkgs#elan -c lake "$@"; fi); }
tool() { t=$1; shift; lake_do build -q LuaLean >&2 && lake_do env lean --run "tools/$t.lean" "$@"; }
usage() { sed -n '4,17s/^#   //p' "$0" >&2; exit 2; }
# the reference LuaJIT's version: bump it with flake.lock, then regenerate test/cases.lua.gz (DESIGN.md)
ref=2.1.1791890110
luajit_ref() {
  if [ -z "$LUAJIT" ]; then
    if command -v nix >/dev/null && p=$(nix build "$here/..#luajit" --no-link --print-out-paths 2>/dev/null); then
      LUAJIT=$p/bin/luajit
    else LUAJIT=$(command -v luajit) || { echo "lua-lean needs nix or luajit on the PATH" >&2; exit 1; }; fi
    shown=
  else shown=1; fi
  v=$("$LUAJIT" -v | cut -d' ' -f2)
  [ -n "$shown" ] || echo "luajit $v: $LUAJIT" >&2
  [ "$v" = "$ref" ] || echo "WARNING: luajit $v is not the reference LuaJIT $ref (DESIGN.md); its results may differ" >&2
}
files() { r=; for f in "$@"; do r="$r $(abs "$f")"; done; printf %s "$r"; }

cmd=$1; [ $# -gt 0 ] && shift
case $cmd in
lift)
  [ $# -ge 1 ] || usage
  f=$(abs "$1"); shift
  ns=${1:-$(basename "$f" .lua | awk '{print toupper(substr($0,1,1)) substr($0,2)}')}
  [ $# -gt 0 ] && shift
  tool Lift "$ns" "$f" "$@" ;;
prove)
  [ $# -ge 1 ] || usage
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp"' EXIT
  bad=0
  for f in $(files "$@"); do
    m=$(basename "$f" .lua)
    if ! tool Lift Lifted "$f" >"$tmp/$m.lean"; then echo "$m: not translated"; bad=1; continue; fi
    if grep -nEw 'sorry|admit|native_decide|axiom' "$tmp/$m.lean"; then echo "$m: an open proof or an axiom"; bad=1; continue; fi
    if lake_do env lean "$tmp/$m.lean" >"$tmp/$m.out" 2>&1; then echo "$m: $(grep -c '^theorem .*_ok' "$tmp/$m.lean") functions proved"
    else echo "$m: proof fails"; grep error "$tmp/$m.out" | head -5; bad=1; fi
  done
  exit $bad ;;
dump)
  [ $# -ge 2 ] || usage
  a=; while [ $# -ge 2 ]; do a="$a $1 $(abs "$2")"; shift 2; done
  tool Dump $a ;;
print) [ $# -eq 1 ] || usage; tool Print "$(abs "$1")" ;;
run)
  a=; while [ $# -gt 0 ]; do
    if [ "$1" = --lib ]; then a="$a --lib ${2%%=*}=$(abs "${2#*=}")"; shift 2; else a="$a $(abs "$1")"; shift; fi
  done
  [ -n "$a" ] || usage
  tool Run $a ;;
cases) [ $# -eq 3 ] || usage; tool Cases "$1" "$2" "$(abs "$3")" ;;
difftest)
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp"' EXIT
  luajit_ref
  seed=${2:-$(date +%s)}
  echo "seed $seed"
  # from lua-lean/, where the chunks find test/mods
  tool Cases "${1:-3000}" "$seed" "$tmp/cases.lua" && cd "$here" && "$LUAJIT" test/luasem.lua --cases "$tmp/cases.lua" &&
    "$LUAJIT" -joff test/luasem.lua --cases "$tmp/cases.lua" ;;
check)
  per=20; [ "$1" = -n ] && { per=$2; shift 2; }
  lean=; [ "$1" = --lean ] && { lean=1; shift; }
  [ $# -ge 1 ] || usage
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp"' EXIT
  # compiled: under lean --run a corpus file's calls took minutes each (#70)
  lake_do build -q check >&2 && "$here/.lake/build/bin/check" "$PWD" "$tmp/cases.lua" "$per" $(files "$@"); r=$?
  [ $r -le 1 ] && [ -z "$lean" ] || exit $r
  luajit_ref
  cd "$here" && "$LUAJIT" test/luasem.lua --cases "$tmp/cases.lua" --any &&
    "$LUAJIT" -joff test/luasem.lua --cases "$tmp/cases.lua" --any || r=1
  exit $r ;;
corpus)
  secs=120; [ "$1" = -t ] && { secs=$2; shift 2; }
  dir=${1:-${XDG_CACHE_HOME:-$HOME/.cache}/lua-lean-corpus}
  list() { grep -v '^#' "$here/test/corpus.txt" | while read -r repo sha lic paths; do
    for p in $paths; do echo "$repo $sha $repo/$p"; done; done; }
  list | while read -r repo sha f; do
    [ -s "$dir/$f" ] && continue
    mkdir -p "$(dirname "$dir/$f")" && curl -sfL -o "$dir/$f" "https://raw.githubusercontent.com/$repo/$sha/${f#"$repo"/}" ||
      { echo "$f: not fetched" >&2; exit 1; }
  done || exit 1
  # the semantics runs no effect: nothing fetched runs outside it
  # a file at a time, so one that runs long is cut off at $secs, not the run; the build first, outside the limit
  lake_do build -q check >&2 || exit 1
  start=$(date +%s)
  out=$(cd "$dir" && for f in $(list | cut -d' ' -f3); do
    timeout "$secs" "$here/lua-lean" check -n 5 --lean "$f" || [ $? -ne 124 ] || echo "$f: timed out after ${secs}s"
  done)
  printf '%s\n' "$out"
  # per file once: each construct outside the subset (the message up to its first ':')
  printf '%s\n' "$out" | awk '
    / parse error: / { n++; next }
    / timed out after / { n++; to++; next }
    / outside the subset, / { n++; ok++; if ($3 == 0) sub_++; fn += $7; cs += $9; next }
    /^[^ ]*:[0-9]+: / { f = $1; sub(/:[0-9]+:$/, "", f); m = $0; sub(/^[^ ]* /, "", m); sub(/:.*/, "", m)
      if (m !~ /^(effect|undefined) / && !seen[f SUBSEP m]++) count[m]++ }
    END { printf "\n%d files: %d parse, %d in the subset, %d timed out; %d top-level functions, %d pure cases; %ds\n",
        n, ok, sub_, to, fn, cs, took
      for (m in count) printf "%4d  %s\n", count[m], m | "sort -rn | head -25" }' took=$(($(date +%s) - start)) ;;
parsecheck)
  [ $# -ge 1 ] || usage
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf "$tmp"' EXIT
  luajit_ref
  lake_do build -q LuaLean || exit 1
  # every number constant at full precision: the listing shows them at %.14g
  cat > "$tmp/k.lua" <<'EOF'
local u = require("jit.util")
local function dump(f)
  for n = -1, -1e9, -1 do local k = u.funck(f, n); if k == nil then break end; if type(k) == "proto" then dump(k) end end
  for n = 0, 1e9 do local k = u.funck(f, n); if k == nil then break end; print(string.format("KNUM %.17g", k)) end
end
dump(assert(loadfile(arg[1])))
EOF
  # the listing without file names and line numbers, then the number constants
  bc() {
    "$LUAJIT" -bl "$1" > "$2.raw" && LC_ALL=C sed -e 's/^-- BYTECODE -- .*/-- BYTECODE --/' -e '/ FNEW /s/ *;.*$//' "$2.raw" > "$2" &&
    "$LUAJIT" "$tmp/k.lua" "$1" >> "$2"
  }
  fail=0
  for f in $(files "$@"); do
    n=$(basename "$f")
    if ! lake_do env lean --run tools/Print.lean "$f" > "$tmp/$n"; then echo "$n: parse error"; fail=1; continue; fi
    if ! bc "$f" "$tmp/$n.src" || ! bc "$tmp/$n" "$tmp/$n.out"; then echo "$n: luajit failed"; fail=1; continue; fi
    if diff -u "$tmp/$n.src" "$tmp/$n.out" > "$tmp/$n.diff"; then echo "$n: same bytecode"
    else echo "$n: bytecode differs"; cat "$tmp/$n.diff"; fail=1; fi
  done
  exit $fail ;;
luajit) luajit_ref; printf '%s\n' "$LUAJIT" ;;
*) usage ;;
esac
