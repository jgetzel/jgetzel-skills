#!/bin/sh
# The Lua swarm CLI, swarm/swarm's fallback while swarm-lean is not built (research/sw-lua.md §3, §4): find the real
# file through symlinks, put its lua/ dir and the per-user rock tree on the module path, exec main.lua. Without luajit:
# say so with $SWARM_INSTALL_HINT (swarm/swarm sets it to swarm-lean's build), and never block a hook.
p=$0
while [ -L "$p" ]; do
  l=$(readlink "$p")
  case $l in /*) p=$l ;; *) p=$(dirname "$p")/$l ;; esac
done
here=$(cd -P "$(dirname "$p")" && pwd)
tree=${XDG_DATA_HOME:-$HOME/.local/share}/swarm/lua
export SWARM_HERE="$here"
export LUA_PATH="$here/lua/?.lua;$tree/share/lua/5.1/?.lua;$tree/share/lua/5.1/?/init.lua;${LUA_PATH:-;}"
export LUA_CPATH="$tree/lib/lua/5.1/?.so;${LUA_CPATH:-;}"
# no double quotes or backslashes in it: the hook branch below writes it into JSON as is
if [ -n "$SWARM_INSTALL_HINT" ]; then :
elif command -v nix >/dev/null 2>&1; then
  SWARM_INSTALL_HINT="nix profile install --impure --expr 'with import <nixpkgs> {}; luajit.withPackages (p: with p; [ lsqlite3 lua-cjson luaposix lrexlib-pcre2 luafilesystem argparse luautf8 ])' (or that withPackages in home.packages)"
else
  SWARM_INSTALL_HINT="LuaJIT and its rocks, per $here/research/sw-lua.md section 4 (Homebrew, apt or dnf, then luarocks into $tree)"
fi
export SWARM_INSTALL_HINT
if command -v luajit >/dev/null 2>&1; then
  exec luajit "$here/lua/swarm/main.lua" "$@"
fi
msg="swarm hooks are OFF: luajit is not on PATH; install with $SWARM_INSTALL_HINT"
if [ "$1" = hook ]; then
  [ -n "$SWARM_NAME" ] || exit 0
  case $2 in
    pre-tool) ev=PreToolUse ;; post-tool) ev=PostToolUse ;; prompt) ev=UserPromptSubmit ;; session) ev=SessionStart ;;
    *) echo "swarm: $msg" >&2; exit 1 ;;
  esac
  printf '{"hookSpecificOutput": {"hookEventName": "%s", "additionalContext": "%s"}, "systemMessage": "%s"}\n' "$ev" "$msg" "$msg"
  exit 0
fi
echo "swarm: luajit is not on PATH; install $SWARM_INSTALL_HINT" >&2
exit 127
