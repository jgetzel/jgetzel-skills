#!/bin/sh
# The swarm CLI: swarm-lean (lean/) when its binary is built and no source is newer, else the Lua CLI (swarm-lua) with
# one stderr line saying how to build it. A hook gets no such line and never waits on a build.
p=$0
while [ -L "$p" ]; do
  l=$(readlink "$p")
  case $l in /*) p=$l ;; *) p=$(dirname "$p")/$l ;; esac
done
here=$(cd -P "$(dirname "$p")" && pwd)
export SWARM_HERE="$here" SWARM_LUA_CLI="$here/swarm-lua"
# lake's binary (lean/build.sh touches it), then nix's out-link (its own mtime: find -newer does not follow it)
for ref in "$here/lean/.lake/build/bin/swarm-lean" "$here/lean/.lake/nix"; do
  bin=$ref; [ "$ref" = "$here/lean/.lake/nix" ] && bin=$ref/bin/swarm-lean
  [ -x "$bin" ] || continue
  # the exe's sources: lean/ but its tests, audit and hpl build; the model files the lakefile's SwarmModelGlob builds
  new=$(cd "$here" && find lean/Main.lean lean/lakefile.lean lean/lean-toolchain lean/SwarmLean lean/c \
    model/SwarmModel/Glob.lean model/SwarmModel/Model.lean model/SwarmModel/PrWatch.lean model/SwarmModel/Decide.lean \
    -newer "$ref" 2>/dev/null | head -n 1)
  [ -z "$new" ] && exec "$bin" "$@"
  why="is older than $new"
done
# no double quotes or backslashes in it: swarm-lua's hook branch writes it into JSON as is
export SWARM_INSTALL_HINT="$here/lean/build.sh"
[ "$1" = hook ] || echo "swarm: running the Lua CLI: swarm-lean ${why:-is not built}; build it with $SWARM_INSTALL_HINT" >&2
exec "$here/swarm-lua" "$@"
