#!/bin/sh
# swarm-report: runs swarm-lean's swarm-report (swarm/lean/Report.lean); swarm/lean/build.sh builds it.
p=$0
while [ -L "$p" ]; do
  l=$(readlink "$p")
  case $l in /*) p=$l ;; *) p=$(dirname "$p")/$l ;; esac
done
here=$(cd -P "$(dirname "$p")" && pwd)
export SWARM_RETRO_HERE="$here"
# shortcut: no staleness check as swarm/swarm's; rebuild after a pull with build.sh
for bin in "$here/../swarm/lean/.lake/build/bin/swarm-report" "$here/../swarm/lean/.lake/nix/bin/swarm-report"; do
  [ -x "$bin" ] && exec "$bin" "$@"
done
echo "swarm-report: not built; build it with $here/../swarm/lean/build.sh" >&2
exit 127
