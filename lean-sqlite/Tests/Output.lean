/-! ### .mode arguments (errors are the text sqlite3 prints, without the "line N: " prefix of each line) -/

private def errOf : Except String Settings → String
  | .error e => e
  | .ok _ => ""

#guard errOf (setMode {} ["foo"]) == ".mode foo\n      ^--- unknown mode\nUse \".help .mode\" for more info"
#guard errOf (setMode {} ["csv", "bar", "baz"]) == ".mode csv bar baz\n              ^--- bad argument\nUse \".help .mode\" for more info"
#guard errOf (setMode {} ["--bogus"]) == ".mode --bogus\n      ^--- bad option\nUse \".help .mode\" for more info"
#guard errOf (setMode {} ["box", "--titles", "x"]) == ".mode box --titles x\n                   ^--- bad --titles value\nshould be off, on, always, auto, plain, sql, csv, html, tcl, or json"
#guard errOf (setMode {} ["box", "--align"]) == ".mode box --align\n          ^--- missing argument"
#guard errOf (setMode {} ["box", "--align", "xyz"]) == ".mode box --align xyz\n                  ^--- bad alignment string\nShould contain only characters L, C, and R."
#guard errOf (setMode {} ["box", "--escape", "bad"]) == ".mode box --escape bad\n                   ^--- unknown escape type\nshould be auto, off, ascii, or symbol"
#guard errOf (setMode {} ["box", "--limits", "1"]) == ".mode box --limits 1\n   bad argument ---^\nShould be \"on\" or \"off\" or \"L,C,T\" where L, C, and T are unsigned integers"
#guard errOf (setMode {} ["box", "--blob-quote"]) == ".mode box --blob-quote\n          ^--- missing argument"
#guard errOf (setMode {} ["box", "--widths", "a"]) == "should be a comma-separated list if integers"
#guard errOf (setMode {} ["box", "--widths", "20000"]) == "Maximum column width is 10000"
#guard errOf (setMode {} ["--quote", "nope"]) == ".mode --quote nope\n   unknown ---^\nshould be off, on, sql, csv, html, tcl, json, or relaxed"
#guard errOf (setMode {} ["list", "--null"]) == ".mode list --null\n           ^--- missing argument"
#guard errOf (setMode {} ["www"]) == ".mode www\n      ^--- unknown mode\nUse \".help .mode\" for more info"
#guard (setMode {} ["csv", "bar"]).toOption.map (·.tableName) == some "bar"
#guard (setMode {} ["insert", "t"]).toOption.map (·.mode) == some (Mode.insert "t")
#guard (setMode {} ["--tablename", "x", "insert"]).toOption.map (·.mode) == some (Mode.insert "x")
#guard (setMode {} ["box"]).toOption.map (·.mode) == some Mode.box
#guard (setMode {} []).toOption.map (·.mode) == some Mode.list
#guard ((setMode {} ["box", "--escape", "symbol"]).toOption.map (·.eEsc)) == some Esc.symbol
#guard (match setMode (({} : Settings).setHeaders .on) ["box"] with | .ok s => s.titles == .on | .error _ => false)
#guard (match setMode (({} : Settings).setHeaders .off) ["box"] with | .ok s => s.titles == .off | .error _ => false)

/-! ### Widths of characters, integer arguments -/

#guard wcwidth 0x41 == 1
#guard wcwidth 0x301 == 0
#guard wcwidth 0x65e5 == 2
#guard wcwidth 0xff57 == 2
#guard wcwidth 0x1d11e == 1
#guard wcwidth 0x20b9f == 2
#guard (displayWidth "a\tb\ncde".toUTF8 0 8) == (9, 1)
#guard integerValue "10" == 10
#guard integerValue "-5" == -5
#guard integerValue "0x10" == 16
#guard integerValue "2K" == 2000
#guard integerValue "1KiB" == 1024
#guard integerValue "99999999999999999999" == 9223372036854775807
#guard integerValue "abc" == 0
#guard booleanValue "on" && booleanValue "yes" && booleanValue "1" && !booleanValue "off" && !booleanValue "0"
