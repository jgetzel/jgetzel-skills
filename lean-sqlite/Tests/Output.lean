import LSql.Output

/-! Tests for LSql.Output. Every expected value was produced by the real sqlite3 3.54.0 shell (stdout piped, so
batch mode): each case is a set of dot-commands, a result set (column names and rows) and the bytes the shell
printed for `select`ing it. The datasets cover NULLs, integers, reals (exponents, infinities), text with
quotes, separators, control characters, newlines, CRLF, tabs, wide, combining and zero-width characters, and
blobs. Cases marked "sqlite" compare .mode outputs of every mode, the dot-commands .headers, .nullvalue,
.separator and .width, and the options of .mode. -/

open LSql LSql.Output

private abbrev DS := Array String × Array (Array Value)

private def applyCmd (s : Settings) (line : String) : Settings :=
  match (line.splitOn " ").filter (· != "") with
  | ".mode" :: args => (setMode s args).toOption.getD s
  | [".headers", "on"] => s.setHeaders .on
  | [".headers", "off"] => s.setHeaders .off
  | [".headers", "always"] => s.setHeaders .always
  | [".nullvalue", z] => s.setNullValue z
  | [".separator", a] => s.setSeparator a
  | [".separator", a, b] => s.setSeparator a (some b)
  | ".width" :: args => s.setWidths (args.map integerValue)
  | _ => s

private def cfg (cmds : List String) : Settings := cmds.foldl applyCmd {}

private def chk (cmds : List String) (d : DS) (exp : String) : Bool :=
  render (cfg cmds) d.1 d.2 == exp.toUTF8

private def chkB (cmds : List String) (d : DS) (exp : Array UInt8) : Bool :=
  render (cfg cmds) d.1 d.2 == ⟨exp⟩

private def dMixed : DS :=
  (#["a", "b", "c"],
   #[#[.int (1), .text "x", .real (Float.ofBits 0x3ff8000000000000)],
