import LSql.DateTime

/-! Tests for LSql.DateTime. Expected values come from sqlite3 3.54 run with TZ=UTC (the local zone is UTC in
LSql.DateTime). Each line: result type, then the value (reals as %.17g). -/

open LSql LSql.DateTime

def ev : Value → String
  | .null => "null|NULL"
  | .int i => "integer|" ++ toString i
  | .real f => "real|" ++ Num.printf "%.17g" [.real f]
  | .text s => "text|" ++ s
  | .blob _ => "blob|"

def q (fn : String) (args : Array Value) : String :=
  match call fn args none with
  | .ok v => ev v
  | .error e => "error|" ++ e

def qNow (fn : String) (args : Array Value) (ms : Int64) : String :=
  match call fn args (some ms) with
  | .ok v => ev v
  | .error e => "error|" ++ e

-- the clock: 1700000000 is 2023-11-14 22:13:20 UTC
#guard qNow "DATETIME" #[.text "now"] 1700000000000 == "text|2023-11-14 22:13:20"
#guard qNow "DATE" #[] 1700000000000 == "text|2023-11-14"
#guard qNow "TIME" #[.text "now", .text "+1 hour"] 1700000123456 == "text|23:15:23"
#guard qNow "UNIXEPOCH" #[.text "now"] 1700000123456 == "integer|1700000123"
#guard qNow "UNIXEPOCH" #[.text "now", .text "subsec"] 1700000123456 == "real|1700000123.456"
#guard qNow "DATETIME" #[.text "subsec"] 1700000123456 == "text|2023-11-14 22:15:23.456"
#guard qNow "STRFTIME" #[.text "%s %Y", .text "now"] 1700000000000 == "text|1700000000 2023"
#guard q "DATETIME" #[.text "now"] == "null|NULL"
#guard q "NOSUCH" #[] == "error|no such function: NOSUCH"
#guard isDateFn "STRFTIME" && !isDateFn "LENGTH"
#guard q "TIMEDIFF" #[.text "2023-01-01"] == "error|wrong number of arguments to function timediff()"

